# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches (pytest, ruff and mypy are pointed at tests/ in pyproject.toml;
# these patterns are unanchored so they also catch a stray root-level run)
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.python-version
*.log

# Environment / secrets
.env
.env.*
*.env

# Editors and OS cruft
.idea/
.vscode/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Downloaded media and yt-dlp intermediates. These land wherever -o points,
# which can be any folder inside the checkout, so the patterns are unanchored.
# If a deliberate media fixture is ever added, re-include it explicitly, e.g.:
#   !tests/fixtures/**
*.part
# Fragment temporaries are named "<file>.part-FragN".
*.part-Frag*
*.ytdl
*.mp4
*.mkv
*.webm
*.mp3
*.m4a
*.opus
# Containers the no-ffmpeg single-file path can hand back.
*.m4v
*.3gp
*.flv
*.ogg
*.aac
*.wav
# Subtitle formats yt-dlp may write with --subtitles.
*.vtt
*.srt
*.ass
*.ttml
*.json3
*.srv[123]

# Pre-publication audit working documents. Internal records written in terms of
# the audit's own finding numbers; not project deliverables.
/tests/AUDIT_FINDINGS.md
/tests/FINDINGS.md
/tests/LOG.md
/tests/VERIFY.md
